{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/h2-sentinel/?mode=fixture",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/h2-sentinel",
      "destination": "/index.html"
    },
    {
      "source": "/h2-sentinel/",
      "destination": "/index.html"
    }
  ]
}
