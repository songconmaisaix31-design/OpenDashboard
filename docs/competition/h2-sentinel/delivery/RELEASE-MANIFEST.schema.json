{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2-sentinel/release-manifest.schema.json",
  "title": "H2 Sentinel Epoch Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseSha", "contractGate", "runId", "tasks", "dispatches", "commits", "tests", "deployment", "submission", "verdict"],
  "properties": {
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contractGate": {
      "type": "object", "additionalProperties": false,
      "required": ["contractsTree", "vocabularyTree", "analyticsContractsBlob"],
      "properties": {
        "contractsTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "vocabularyTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "analyticsContractsBlob": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "runId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "dispatches": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["dispatchId", "taskId", "status"], "properties": { "dispatchId": { "type": "string", "minLength": 1 }, "taskId": { "type": "string", "minLength": 1 }, "status": { "$ref": "#/$defs/status" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/path" } } } }
    },
    "commits": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["taskId", "localSha", "remoteSha", "status"], "properties": { "taskId": { "type": "string", "minLength": 1 }, "localSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "remoteSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "status": { "$ref": "#/$defs/status" } } }
    },
    "tests": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["taskId", "command", "status"], "properties": { "taskId": { "type": "string", "minLength": 1 }, "command": { "type": "string", "minLength": 1, "maxLength": 500 }, "status": { "$ref": "#/$defs/status" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/path" } } } }
    },
    "deployment": { "$ref": "#/$defs/releaseArea" },
    "submission": { "$ref": "#/$defs/releaseArea" },
    "verdict": { "type": "string", "enum": ["PASS", "HOLD", "FAIL"] }
  },
  "$defs": {
    "status": { "type": "string", "enum": ["passed", "failed", "pending", "not-delivered"] },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)[^\\r\\n]+$" },
    "releaseArea": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": { "status": { "$ref": "#/$defs/status" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/path" } }, "url": { "type": "string", "format": "uri", "maxLength": 500 }, "reason": { "type": "string", "maxLength": 1000 } }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "owner", "writePaths", "status"],
      "properties": { "taskId": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 }, "writePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "status": { "$ref": "#/$defs/status" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/path" } } }
    }
  }
}
